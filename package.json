{
	"name": "obsidian-yamltemplate",
	"version": "1.0.0",
	"description": "Render a fenced yamltemplate code block by applying its YAML data to a Handlebars HTML template resolved from a configurable templates folder.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint . --ext .ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"handlebars",
		"yaml",
		"template"
	],
	"author": "pdudley",
	"license": "MIT",
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "^7.13.0",
		"@typescript-eslint/parser": "^7.13.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"eslint": "^8.57.0",
		"obsidian": "^1.4.11",
		"tslib": "^2.6.2",
		"typescript": "^5.4.0",
		"vitest": "^1.6.0"
	},
	"dependencies": {
		"handlebars": "^4.7.8",
		"js-yaml": "^4.1.0"
	}
}
